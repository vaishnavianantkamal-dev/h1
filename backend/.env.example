NODE_ENV=development
PORT=8000
APP_URL=http://localhost:8000
TZ=Asia/Kolkata

# ---- MySQL (use the SAME database the Laravel app used) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hobit
DB_USERNAME=root
DB_PASSWORD=
DB_LOG=false

# Comma separated extra CORS origins
CORS_ORIGINS=

# Secret used by /cron/* HTTP endpoints (was CRON_SECRET / CRON_SECRET_NEW)
CRON_SECRET=
# Set to false to stop the in-process cron scheduler + job worker
RUN_SCHEDULER=true

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- WhatsApp ----
HOBIT_WHATSAPP_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_URL=
WHATSAPP_CLOUD_API_URL=

# ---- SMS ----
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_TEMPLATE_ID_LOGIN=
SMS_TEMPLATE_ID_START=
SMS_TEMPLATE_ID_CLOSE=
SMS_API_BASE_URL=

# ---- Business config (was config/services.php) ----
INSTANT_EXTEND_SERVICE_ID=
INSTANT_CATEGORY_ID=6
WEEKDAY_CATEGORY_ID=
WORKER_WITHDRAW_MIN_AMOUNT=100
RESCHEDULE_MAX_PER_MONTH=4
RESCHEDULE_MAX_PER_WEEK=1
RESCHEDULE_INSTANT_MIN_HOURS=3
RESCHEDULE_MONTHLY_MIN_HOURS=3
MONTHLY_SUBSCRIPTION_TYPE_ID=4
BOOKING_CANCELLATION_DEDUCTION_PERCENT=20

# ---- Surepass KYC ----
SUREPASS_API_TOKEN=
SUREPASS_BASE_URL=https://sandbox.surepass.io/api/v1

# ---- Weather Union ----
WEATHERUNION_API_KEY=
WEATHERUNION_BASE_URL=https://www.weatherunion.com/gw/weather/external/v0
WEATHERUNION_DEFAULT_LOCATION=18.5204,73.8567
WEATHERUNION_CACHE_TTL=600
WEATHERUNION_TIMEOUT=10

# ---- Mail ----
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Hobit

# ---- Firebase (path to service-account json, same file as Laravel's firebase/ folder) ----
FIREBASE_CREDENTIALS=./firebase/service-account.json
FIREBASE_DATABASE_URL=

APP_NAME=Hobit
CUSTOMER_FIREBASE_CREDENTIALS=./storage/app/customer-firebase.json
APP_KEY=
ADMIN_EMAIL=admin@instantcook.com
FRONTEND_URL=

# ---- First admin created by npm run db:setup ----
SEED_ADMIN_PHONE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Security ----
# Review-mode logins (customer 9999999999 / worker 8888888888, OTP 123456). Off in production unless set to true.
STATIC_LOGIN_ENABLED=
# Shared key the WhatsApp bot must send (header x-api-key) to call /api/bot/* and /api/whatsapp/send*
BOT_API_KEY=
